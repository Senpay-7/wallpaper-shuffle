<resources>
    <!-- Always dark: black app, dark-blue controls. No light variant. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorAccent">#3D74FF</item>
        <item name="android:colorPrimary">#16306E</item>
        <item name="android:colorControlActivated">#3D74FF</item>
        <item name="android:alertDialogTheme">@style/DarkDialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="DarkDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#0B1020</item>
        <item name="android:colorAccent">#6E9BFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
    </style>
</resources>
